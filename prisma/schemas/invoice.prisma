enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model Invoice {
  id            String        @id @default(uuid())
  userId        String
  invoiceNumber String        @unique
  customerName  String
  issueDate     DateTime
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  subtotal      Int
  taxRate       Int           @default(11)
  taxAmount     Int
  total         Int
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user  User          @relation(fields: [userId], references: [id])
  items InvoiceItem[]
}
