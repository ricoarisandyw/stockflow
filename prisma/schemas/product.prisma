model Product {
  id             String   @id @default(uuid())
  userId         String
  sku            String
  name           String
  description    String?
  unitPrice      Int
  quantityOnHand Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id])
  items InvoiceItem[]

  @@unique([userId, sku])
  @@index([userId])
}
